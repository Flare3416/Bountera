# =========================================================================
# Bountera Environment Variables Template
# Copy this file to .env.local (for Next.js) and .env (for Prisma CLI)
# =========================================================================

# Database Connection (Neon PostgreSQL)
# Prisma client and migrations connect to Neon using this URI.
DATABASE_URL="postgresql://username:password@ep-host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth Configuration
# For local development: http://localhost:3000
# For production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Generate a secure 32-byte secret using: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Google OAuth Credentials
# Retrieve these from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_ID="your-google-client-id"
GOOGLE_SECRET="your-google-client-secret"

# GitHub OAuth Credentials
# Retrieve these from GitHub Developer Settings (OAuth Apps)
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# Razorpay Integration (Optional for donations)
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
